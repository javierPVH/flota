{
  "name": "@flota/ui",
  "version": "1.0.0",
  "type": "module",
  "description": "Design-system / librería base compartida (React 19 + TS + Vite + SASS). Repo autónomo y levantable por sí solo.",
  "license": "UNLICENSED",
  "author": "Gransolar",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.sass"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION_GUIDE.md",
    "PLAN_EXTRACCION_BASE.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "vite build --mode app",
    "preview": "vite preview --mode app",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "prepack": "npm run build",
    "clean": "rm -rf dist dist-app"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/src/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./table": {
      "types": "./dist/src/ui/table/index.d.ts",
      "import": "./dist/ui/table/index.js"
    },
    "./excel": {
      "types": "./dist/src/excel/index.d.ts",
      "import": "./dist/excel/index.js"
    },
    "./forms": {
      "types": "./dist/src/forms/index.d.ts",
      "import": "./dist/forms/index.js"
    },
    "./hooks": {
      "types": "./dist/src/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/src/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./http": {
      "types": "./dist/src/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./auth": {
      "types": "./dist/src/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./i18n": {
      "types": "./dist/src/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./base.css": "./dist/base.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "sass-embedded": "^1.99.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "xlsx": "^0.18.5"
  }
}
