# Configuración de INFRAESTRUCTURA de docker compose (cópialo a `.env`).
#   cp .env.example .env
# El fichero `.env` real está en .gitignore (no se sube).

# --- QUÉ APLICACIONES SE LEVANTAN -----------------------------------------
# Perfiles de Docker Compose, coma-separado. El back va siempre.
#   gestion              -> back + front de gestión (interna/VPN)
#   conductores          -> back + front de conductores (internet vía túnel)
#   gestion,conductores  -> back + los dos fronts
COMPOSE_PROFILES=gestion,conductores

# Etiqueta de las imágenes construidas.
IMAGE_TAG=latest

# Carpeta de datos persistentes en el servidor (BD SQLite, media, estáticos).
DATA_DIR=./data

# Procesos de gunicorn del back.
GUNICORN_WORKERS=3

# --- Base de datos (PostgreSQL propio de Flota, servicio `db`) -------------
# Las usan `db` (POSTGRES_*) y `back` (DB_*). La contraseña SIN el símbolo '$'
# (compose lo interpreta como variable). Solo letras/números/-_.
DB_NAME=flota
DB_USER=flota
DB_PASSWORD=CAMBIA_ESTO_sin_signo_dolar

# --- Puertos de loopback del servidor (elegidos porque están LIBRES) ------
# Ocupados en srvgcptd: 80, 1433, 4001, 5000-5150, 5432, 8080, 8083, 8084,
# 8090, 8091, 9000, 9443. Estos dos están libres:
#
# Conductores (público): lo alcanza el Cloudflare Tunnel en http://localhost:8092
CONDUCTORES_PORT=8092
# Gestión (interna/VPN): NO se cuelga del túnel.
GESTION_PORT=8093
# Interfaz donde se publica gestión:
#   127.0.0.1 -> solo desde el propio servidor (o túnel SSH)
#   10.3.4.6  -> alcanzable desde la VPN/LAN (IP interna de este servidor)
#   0.0.0.0   -> todas las interfaces (el firewall/tunnel debe cerrar el exterior)
GESTION_BIND=127.0.0.1
