# --- Núcleo ---------------------------------------------------------------
# Ponlo a True SOLO en desarrollo.
DEBUG=True
# Obligatorio en producción (DEBUG=False). Genera uno con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Obligatorio en producción. Coma-separado, nunca '*'.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LOG_LEVEL=WARNING

# --- Base de datos --------------------------------------------------------
# Por defecto SQLite (sin configuración). Para PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=gs_base
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- CORS / CSRF (SPA en otro origen, con cookies) ------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Cookies / hardening (Fase S2) ---------------------------------------
# En producción (DEBUG=False) los defaults ya son ESTRICTOS: SSL redirect, HSTS
# 1 año, cookies Secure, nosniff, Referrer-Policy same-origin, X-Frame DENY.
# Sobreescribe solo si hace falta:
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_REFERRER_POLICY=same-origin
# Activa SOLO si hay un proxy de confianza (nginx/LB) que termina TLS delante;
# entonces se confía en X-Forwarded-Proto/Host (si no, son falsificables).
# SECURE_BEHIND_PROXY=True
# SameSite de cookies: "Lax" si front y back comparten dominio; "None" (+Secure)
# si van en dominios distintos y la SPA usa cookies.
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax

# --- Métodos de autenticación (flags independientes) ----------------------
# Activa los que necesite cada despliegue:
#   solo usuarios propios → AUTH_PASSWORD_ENABLED=True,  AUTH_GOOGLE_ENABLED=False
#   solo Google           → AUTH_PASSWORD_ENABLED=False, AUTH_GOOGLE_ENABLED=True
#   ambos                 → los dos a True
AUTH_PASSWORD_ENABLED=True
# Alta de usuarios (self-signup). DESACTIVADO: los conductores los aprovisiona
# la gestión (el front de conductores es público/internet, sin registro abierto).
AUTH_REGISTRATION_ENABLED=False
AUTH_GOOGLE_ENABLED=False

# Login con Google (requerido si AUTH_GOOGLE_ENABLED=True). Client ID (Web) de
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_OAUTH_CLIENT_ID=
# Restringe a dominios de Workspace (coma-separado). Vacío = cualquier cuenta Google.
GOOGLE_ALLOWED_DOMAINS=
# ¿Crear el usuario la primera vez que entra por Google? False = solo pre-aprovisionados.
# SEC10: default cerrado — actívalo explícitamente si quieres auto-alta por Google.
GOOGLE_AUTO_CREATE_USERS=True

# --- Rate limit de login --------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_BLOCK_SECONDS=300
# Límite adicional POR CUENTA (frena fuerza bruta distribuida entre muchas IPs).
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=20
# Nº de proxies de confianza delante de la app (0 = ignora X-Forwarded-For y usa
# REMOTE_ADDR). Detrás de nginx/LB, ponlo al nº de saltos que insertan XFF.
TRUSTED_PROXY_COUNT=0
# Throttle de endpoints sensibles sin auth (ScopedRateThrottle).
THROTTLE_REGISTER_RATE=5/hour
THROTTLE_GOOGLE_RATE=30/min

# --- Flota: alertas / trabajos programados (Fase E) -----------------------
# Días antes de la ITV en los que se avisa (escalonado, coma-separado).
FLEET_ITV_ALERT_DAYS=30,15,7
# Días que un vehículo activo puede estar sin conductor antes de avisar.
FLEET_NO_DRIVER_ALERT_DAYS=30
# Margen sobre los km contratados a partir del cual la proyección alerta (0.05 = 5%).
FLEET_KM_OVERAGE_MARGIN=0.05
# Umbral "a vigilar" del summary de proyección (0.95 = 95% del límite) — Fase A1.
# FLEET_KM_WATCH_PCT=0.95

# --- Flota: datos de PRUEBA en desarrollo (ver back/SEED_DEV.md) ----------
# 🔴 DESTRUCTIVO: True = cada arranque de `runserver` borra los datos y siembra
# los de prueba. Solo actúa con DEBUG=True (en producción se ignora). Activa
# además el login de desarrollo (selector de usuarios, sin Google) en el front.
FLEET_SEED_DATA=False

# --- Flota: subida de documentos (Fase A1) --------------------------------
# Tamaño máximo del fichero subido (MB). Extensiones: jpg/jpeg/png/webp/heic/pdf.
# FLEET_DOCUMENT_MAX_MB=10
# Carpeta de media (por defecto BASE_DIR/media). En producción la sirve nginx.
# DJANGO_MEDIA_ROOT=

# --- Flota: integraciones (Fase F) ----------------------------------------
# Archivado de documentos: none | local | gdrive.
FLEET_ARCHIVE_BACKEND=none
# Carpeta del fallback local (backend=local). Por defecto BASE_DIR/archive.
# FLEET_ARCHIVE_LOCAL_DIR=
# Google Drive (backend=gdrive): requiere credenciales.
GOOGLE_DRIVE_ENABLED=False

# --- Google Drive / Picker (Fase A3) --------------------------------------
# Todos los documentos y facturas viven en Drive; la BD guarda solo referencias.
# Vía escritorio (Picker): OAuth de usuario. Reusa GOOGLE_OAUTH_CLIENT_ID (arriba)
# y necesita además el secret + la redirect autorizada en Google Cloud Console.
GOOGLE_OAUTH_ENABLED=False
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback/
# Scopes (coma-separado). Por defecto: openid, email, drive.file, drive.readonly.
# GOOGLE_OAUTH_SCOPES=
# API key + App ID (número de proyecto) para el Google Picker del front.
GOOGLE_API_KEY=
GOOGLE_PICKER_APP_ID=
# Vía móvil (archivador): cuenta de servicio que sube el multipart a Drive.
# Ruta al JSON de la SA; la carpeta raíz debe estar COMPARTIDA con su email (editor).
GOOGLE_SA_KEYFILE=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# A dónde vuelve el navegador tras conectar Google (el front de gestión).
# FRONTEND_BASE_URL=http://localhost:5173
# Timeout (s) y reintentos de las llamadas a Google.
# GOOGLE_HTTP_TIMEOUT=30
# GOOGLE_NUM_RETRIES=3
# Claves Fernet (coma-separado; la 1ª cifra, todas descifran) para los tokens
# OAuth en BD. Vacío = derivada de SECRET_KEY (vale si el secreto no rota).
# FIELD_ENCRYPTION_KEYS=
# Importación de solicitudes desde Jira (Épica 8).
FLEET_JIRA_ENABLED=False
# FLEET_JIRA_URL=
# FLEET_JIRA_TOKEN=

# --- Observabilidad / API (Fase O1) --------------------------------------
# Logs en JSON (una línea por evento) para agregadores; en dev, texto legible.
# LOG_JSON=True
# Captura de errores en Sentry (requiere `sentry-sdk` instalado).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Ritmo de escritura del front público (subida de docs / lecturas de km).
# THROTTLE_PUBLIC_WRITE_RATE=60/min

# --- Opcionales -----------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# OPENAPI_DOCS_ENABLED=True

# --- N9: notificaciones push (Web Push / VAPID) ----------------------------
# Sin claves VAPID el push queda deshabilitado limpiamente (no-op con traza).
# Genera el par con: python -m py_vapid --gen (o npx web-push generate-vapid-keys)
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# Contacto que exige el protocolo VAPID (mailto: o URL del responsable).
# WEBPUSH_CONTACT=mailto:admin@example.com

# --- Ventanas de kilometraje y avisos de seguro ----------------------------
# Día del mes desde el que se abre la ventana de lectura de km (prod: 23).
# FLEET_KM_WINDOW_START=23
# Día del mes siguiente hasta el que se aceptan lecturas/estimaciones (prod: 10).
# FLEET_KM_ESTIMATE_WINDOW_END=10
# Umbrales (días) de los avisos de vencimiento de seguro (N2).
# FLEET_INSURANCE_ALERT_DAYS=30,15,7
