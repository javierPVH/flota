# Configuración del BACK en producción (cópialo a `back/.env.prod`).
#   cp back/.env.prod.example back/.env.prod
# El fichero real (`.env.prod`) está en .gitignore. NO subas secretos al repo.

# --- Núcleo ---------------------------------------------------------------
DEBUG=False
# Genera uno con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CAMBIA_ESTO
TIME_ZONE=Europe/Madrid
LOG_LEVEL=WARNING
LOG_JSON=True

# Hosts que acepta Django (coma-separado, nunca '*'). Incluye:
#   - 127.0.0.1 y localhost -> sondas de salud internas del contenedor
#   - el dominio público de conductores (Cloudflare)
#   - el host por el que entras a gestión desde la VPN (IP interna o DNS interno)
ALLOWED_HOSTS=127.0.0.1,localhost,flota-conductores.gransolar.com,10.3.4.6

# --- ADMINISTRADOR ÚNICO (se crea/actualiza en cada arranque) -------------
# Único registro que se aprovisiona en producción (no hay datos de prueba:
# el seed solo actúa con DEBUG=True). Con estas credenciales entras en la gestión.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
ADMIN_EMAIL=admin@gransolar.com
# True (por defecto): sincroniza la contraseña con la del entorno en cada arranque.
# Ponlo a False si prefieres cambiarla luego desde /admin y que no se pise.
# B8: con True, CADA arranque del contenedor reaplica ADMIN_PASSWORD, así
# que rotar la contraseña desde la aplicación es imposible (el siguiente
# `docker compose up` la revierte). Ponlo a True solo para aprovisionar.
ADMIN_UPDATE_PASSWORD=False

# --- Detrás de proxy (front-nginx de Flota + Cloudflare por delante) ------
SECURE_BEHIND_PROXY=True
# El TLS lo termina Cloudflare (conductores) y el acceso interno de gestión es
# http por VPN: el redirect a https NO lo hace la app (evita bucles y fallos de
# las sondas). La cadena de proxies de confianza para el rate-limit: cloudflared
# + nginx del front = 2.
SECURE_SSL_REDIRECT=False
TRUSTED_PROXY_COUNT=2

# --- Cookies de sesión/CSRF -----------------------------------------------
# Se marcan NO-Secure a propósito: gestión se sirve por http interno (VPN) y
# necesita que la cookie viaje; conductores solo es alcanzable por https (el
# túnel no expone http), así que en la práctica la cookie nunca va en claro.
# 👉 Si algún día pones gestión también tras https (TLS interno), vuelve a True.
# ⚠️ A15 — DEUDA DE SEGURIDAD ACEPTADA, con fecha de caducidad.
# Django tiene UN solo ajuste para las dos apps, así que poner esto a
# False por el http interno de gestión deja también SIN el flag `Secure`
# la cookie de conductores, que sí viaja por internet: cualquier
# degradación a http en ese dominio la expone. En cuanto gestión tenga
# TLS interno, los dos vuelven a True (y este bloque se borra).
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Orígenes de confianza para CSRF (esquema+host+puerto EXACTOS desde donde el
# SPA hace POST). Ajusta al dominio real y al host/puerto de gestión por VPN.
CSRF_TRUSTED_ORIGINS=https://flota-conductores.gransolar.com,http://10.3.4.6:8093
# Front y back comparten origen (mismo dominio por app), así que CORS casi no
# interviene; se listan por seguridad.
CORS_ALLOWED_ORIGINS=https://flota-conductores.gransolar.com,http://10.3.4.6:8093

# --- Métodos de autenticación ---------------------------------------------
AUTH_PASSWORD_ENABLED=True
# Sin auto-registro: los conductores los da de alta la gestión.
AUTH_REGISTRATION_ENABLED=False

# SEC10: clave(s) de cifrado en reposo de credenciales (Google OAuth). SIN esta
# variable la clave deriva del SECRET_KEY: rotar el SECRET_KEY inutilizaría los
# tokens guardados. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotación: añade la clave NUEVA delante y conserva la vieja detrás (coma).
# B9: settings VALIDA el formato al arrancar (32 bytes en base64 urlsafe);
# un placeholder ya no llega a producción para reventar en el primer uso.
FIELD_ENCRYPTION_KEYS=cambia-esto-genera-una-clave-fernet
AUTH_GOOGLE_ENABLED=False

# --- Base de datos --------------------------------------------------------
# NO pongas aquí las DB_*: la BD es el servicio `db` (PostgreSQL) del compose y
# sus credenciales se definen UNA sola vez en el `.env` de infraestructura
# (DB_NAME/DB_USER/DB_PASSWORD). El compose las inyecta en el back con
# DB_ENGINE=postgres y DB_HOST=db, y sobreescriben cualquier valor de este fichero.

# URL pública del front de gestión: retorno del OAuth de Google y base de los
# enlaces en correos/notificaciones.
# FRONTEND_BASE_URL=http://10.3.4.6:8093

# --- Opcionales -----------------------------------------------------------
# SENTRY_DSN=
# REDIS_URL=redis://redis:6379/0

# --- N10a: correo saliente (avisos de seguro → renting, km → conductor) ------
# Sin EMAIL_HOST el envío queda deshabilitado limpiamente (no-op con traza).
# EMAIL_HOST=smtp.example.com
# A4: timeout de SMTP (s). OBLIGATORIO en producción: sin él un SMTP
# colgado tumba un worker y para el motor de alertas en silencio.
EMAIL_TIMEOUT=10
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=flota@example.com
# EMAIL_HOST_PASSWORD=cambia-esto
# DEFAULT_FROM_EMAIL=flota@example.com

# --- N9: notificaciones push (Web Push / VAPID) ----------------------------
# Sin claves VAPID el push queda deshabilitado limpiamente (no-op con traza).
# Genera el par con: python -m py_vapid --gen (o npx web-push generate-vapid-keys)
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# Contacto que exige el protocolo VAPID (mailto: o URL del responsable).
# WEBPUSH_CONTACT=mailto:admin@example.com

# --- Ventanas de kilometraje y avisos de seguro ----------------------------
# Día del mes desde el que se abre la ventana de lectura de km (prod: 23).
# FLEET_KM_WINDOW_START=23
# Día del mes siguiente hasta el que se aceptan lecturas/estimaciones (prod: 10).
# FLEET_KM_ESTIMATE_WINDOW_END=10
# Umbrales (días) de los avisos de vencimiento de seguro (N2).
# FLEET_INSURANCE_ALERT_DAYS=30,15,7
